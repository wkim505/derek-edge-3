<?xml version="1.0" encoding="UTF-8"?>
<!--
  Editable template node: "Section Landing"
  Installed at: /conf/derek-edge-3/settings/wcm/templates/section-landing

  In AEM author this becomes selectable when creating a new page (once enabled and
  added to the site's Allowed Templates). Pages created from it get
  jcr:content/@cq:template pointing here. Edge Delivery / Universal Editor still
  renders each page from its own authored content; the template supplies the
  initial scaffold (initial/) and the allowed-components policy (policies/).
-->
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          jcr:primaryType="cq:Template"
          jcr:title="Section Landing"
          jcr:description="Section landing/hub page: hero banner with overlay title, short intro, a grid of image+text child-page cards, and a related-links row."
          ranking="{Long}100"
          status="enabled">
  <jcr:content jcr:primaryType="nt:unstructured"
               jcr:title="Section Landing"/>
</jcr:root>
