<?xml version="1.0" encoding="UTF-8"?>
<!--
  Editable template definition: "Section Landing"
  Deploy target (AEM Cloud author): /conf/derek-edge-3/settings/wcm/templates/section-landing

  This is the template node. In AEM author it is created/registered under the
  project configuration and, once enabled, becomes selectable when authors
  create a new page. Pages created from it get:
    jcr:content/@cq:template = /conf/derek-edge-3/settings/wcm/templates/section-landing

  NOTE: Edge Delivery / Universal Editor still renders each page from its own
  authored content (the JCR under jcr:content/root). The template provides the
  initial scaffold (see ./initial/.content.xml) and the allowed-components policy
  (see ./policies/.content.xml). It does NOT override page rendering at runtime.
-->
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          jcr:primaryType="cq:Template"
          jcr:title="Section Landing"
          jcr:description="Section landing/hub page: hero banner with overlay title, short intro, a grid of image+text child-page cards, and a related-links row."
          ranking="{Long}100"
          status="enabled">
  <jcr:content jcr:primaryType="nt:unstructured"
               jcr:title="Section Landing"/>
</jcr:root>
