<?xml version="1.0" encoding="UTF-8"?>
<!--
  Initial content for the "Section Landing" template.
  Deploy target: /conf/derek-edge-3/settings/wcm/templates/section-landing/initial

  This is the scaffold a NEW page receives when an author creates it from this
  template. It contains the four canonical section-landing sections with empty
  blocks / placeholder default content, so the author starts from the right
  structure and fills in real content:

    1. hero        — hero-quicklinks block (background image + H1 title)
    2. intro       — default content: H2 heading + lead paragraph
    3. topic-cards — cards-news block (grid of image + linked heading + text)
    4. related     — light-grey section: H2 "Related" + cards-news block

  The resource types / models match what scripts.js + the block models expect,
  and what @adobe/helix-md2jcr emits for imported pages, so a scaffolded page and
  an imported page are structurally identical.
-->
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="cq:Page">
  <jcr:content cq:template="/conf/derek-edge-3/settings/wcm/templates/section-landing"
               sling:resourceType="core/franklin/components/page/v1/page"
               jcr:primaryType="cq:PageContent"
               jcr:title="Section Landing"
               jcr:description=""
               modelFields="[jcr:title,jcr:description,keywords]">
    <root jcr:primaryType="nt:unstructured"
          sling:resourceType="core/franklin/components/root/v1/root">
      <section sling:resourceType="core/franklin/components/section/v1/section"
               jcr:primaryType="nt:unstructured"
               model="section"
               modelFields="[name,style]"
               name="Hero">
        <block sling:resourceType="core/franklin/components/block/v1/block"
               jcr:primaryType="nt:unstructured"
               model="hero-quicklinks"
               modelFields="[image,imageAlt,text]"
               name="Hero Quicklinks"
               image=""
               imageAlt=""
               text="&lt;p&gt;&lt;h1&gt;Page title&lt;/h1&gt;&lt;/p&gt;"></block>
      </section>
      <section_1 sling:resourceType="core/franklin/components/section/v1/section"
                 jcr:primaryType="nt:unstructured"
                 model="section"
                 modelFields="[name,style]"
                 name="Intro">
        <title sling:resourceType="core/franklin/components/title/v1/title"
               jcr:primaryType="nt:unstructured"
               title="Introduction"
               titleType="h2"/>
        <text sling:resourceType="core/franklin/components/text/v1/text"
              jcr:primaryType="nt:unstructured"
              text="&lt;p&gt;Introductory lead paragraph.&lt;/p&gt;"/>
      </section_1>
      <section_2 sling:resourceType="core/franklin/components/section/v1/section"
                 jcr:primaryType="nt:unstructured"
                 model="section"
                 modelFields="[name,style]"
                 name="Topic cards">
        <block sling:resourceType="core/franklin/components/block/v1/block"
               jcr:primaryType="nt:unstructured"
               filter="cards-news"
               name="Cards News">
          <item_0 jcr:primaryType="nt:unstructured"
                  sling:resourceType="core/franklin/components/block/v1/block/item"
                  name="Card"
                  model="card"
                  modelFields="[image,text]"
                  image=""
                  text="&lt;p&gt;&lt;h3&gt;&lt;a href&#x3D;&quot;#&quot;&gt;Card title&lt;/a&gt;&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;Card description.&lt;/p&gt;"></item_0>
        </block>
      </section_2>
      <section_3 sling:resourceType="core/franklin/components/section/v1/section"
                 jcr:primaryType="nt:unstructured"
                 style="[light-grey]"
                 model="section"
                 modelFields="[name,style]"
                 name="Related">
        <title sling:resourceType="core/franklin/components/title/v1/title"
               jcr:primaryType="nt:unstructured"
               title="Related"
               titleType="h2"/>
        <block sling:resourceType="core/franklin/components/block/v1/block"
               jcr:primaryType="nt:unstructured"
               filter="cards-news"
               name="Cards News">
          <item_0 jcr:primaryType="nt:unstructured"
                  sling:resourceType="core/franklin/components/block/v1/block/item"
                  name="Card"
                  model="card"
                  modelFields="[image,text]"
                  image=""
                  text="&lt;p&gt;&lt;h3&gt;&lt;a href&#x3D;&quot;#&quot;&gt;Related link&lt;/a&gt;&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;Related description.&lt;/p&gt;"></item_0>
        </block>
      </section_3>
    </root>
  </jcr:content>
</jcr:root>
